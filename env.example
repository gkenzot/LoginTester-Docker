# ========================================
# LoginTester Docker - Variáveis de ambiente
# Copie para .env: cp env.example .env
# NUNCA commite o arquivo .env com valores reais.
# ========================================

# ------------------------------
# Email (recuperação de senha, verificação de email)
# Obrigatório para "Esqueci minha senha" e verificação por email.
# Use a conta que enviará os emails (ex.: ktakeapps@gmail.com).
# ------------------------------
GMAIL_USERNAME=ktakeapps@gmail.com
# Senha de app do Gmail (não use a senha normal da conta).
# Como obter: Conta Google → Segurança → Verificação em 2 etapas (ativar) → Senhas de app.
GMAIL_APP_PASSWORD=
# Remetente exibido nos emails (geralmente o mesmo que GMAIL_USERNAME).
EMAIL_FROM=ktakeapps@gmail.com
# URL do frontend (para links nos emails, ex.: recuperação de senha).
FRONTEND_URL=http://localhost:3000
PROFILE_PHOTO_DIR=/app/uploads/profile-photos

# ------------------------------
# Segurança (produção: use true em HTTPS)
# ------------------------------
# Cookie de logout enviado apenas em HTTPS. Em dev (HTTP) deixe false.
# APP_COOKIE_SECURE=false
# HSTS (Strict-Transport-Security). Ative em produção com HTTPS.
# APP_SECURITY_HSTS_ENABLED=false

# ------------------------------
# Spring / Backend
# ------------------------------
# Perfil ativo. Use "dev" para ver SQL no log (spring.jpa.show-sql); em produção use "prod" ou omita.
# SPRING_PROFILES_ACTIVE=dev

# ------------------------------
# Outras variáveis (opcionais; o docker-compose tem valores padrão)
# ------------------------------
# POSTGRES_USER=logintester_admin
# POSTGRES_PASSWORD=logintester_password
# POSTGRES_DB=logintester_db
# JWT_SECRET=your-super-secret-jwt-key-change-in-production
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost,https://localhost
